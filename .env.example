# Copy to .env and fill in. Real deployments inject these as environment
# variables; this file exists so `go run .` works locally.

# Required for live answers. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required for voice input. https://console.deepgram.com
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# Optional: shared storage. Unset, trails live in this process and last as long
# as it does - fine for one instance, wrong for several.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: spend limits on the paid paths. Recall hits are free and never
# counted, so these only apply to real vision and transcription calls.
# RATE_LIMIT_PER_IP_PER_MINUTE=6
# RATE_LIMIT_PER_IP_PER_HOUR=30
# RATE_LIMIT_GLOBAL_PER_DAY=100

# Optional: reasoning depth. low | medium | high
# CAIRN_EFFORT=low
